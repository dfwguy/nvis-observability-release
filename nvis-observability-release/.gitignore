# Runtime credentials and secrets
.env
.nvis-setup-state
.nvis-config
.nvis-creds
.nvis-nodes

# Per-node runtime configs (generated by setup.sh)
node-configs/node*/

# Terraform state and secrets
terraform/.terraform/
terraform/.terraform.lock.hcl
terraform/terraform.tfstate
terraform/terraform.tfstate.backup
terraform/terraform.tfvars

# Logs and temp files
*.log
/tmp/nvis-*.log
/tmp/nvis-deploy-results.txt

# Certs (generated at runtime)
certs/

# OS
.DS_Store
