        "content": "<div style='display:grid;grid-template-columns:repeat(4,1fr);gap:14px;padding:4px'><a href='http://10.127.28.83:3000/d/nvis-live-topology' target='_blank' style='text-decoration:none'><div style='background:#0d1f2d;border:1px solid #388bfd;border-radius:8px;padding:16px;cursor:pointer;transition:all 0.2s;min-height:110px'><div style='font-size:24px;margin-bottom:8px'>\ud83c\udf10</div><div style='color:#79c0ff;font-size:13px;font-weight:bold'>Live Topology</div><div style='color:#8b949e;font-size:11px;margin-top:4px;line-height:1.5'>Interactive cluster map \u00b7 Animated traffic \u00b7 Drag & drop nodes \u00b7 Live fault detection</div><div style='margin-top:8px;font-size:10px;color:#388bfd'>\u2192 Click to open</div></div></a><a href='http://10.127.28.83:3000/d/cluster-overview-cod' target='_blank' style='text-decoration:none'><div style='background:#0d200f;border:1px solid #2ea043;border-radius:8px;padding:16px;min-height:110px'><div style='font-size:24px;margin-bottom:8px'>\ud83d\udcca</div><div style='color:#7ee787;font-size:13px;font-weight:bold'>Cluster Overview</div><div style='color:#8b949e;font-size:11px;margin-top:4px;line-height:1.5'>Node health \u00b7 Active jobs \u00b7 User activity \u00b7 GPU utilization trends</div><div style='margin-top:8px;font-size:10px;color:#2ea043'>\u2192 Click to open</div></div></a><a href='http://10.127.28.83:3000/d/gpu-health-cod' target='_blank' style='text-decoration:none'><div style='background:#1a0d0d;border:1px solid #f85149;border-radius:8px;padding:16px;min-height:110px'><div style='font-size:24px;margin-bottom:8px'>\ud83c\udfae</div><div style='color:#ff7b72;font-size:13px;font-weight:bold'>GPU Health</div><div style='color:#8b949e;font-size:11px;margin-top:4px;line-height:1.5'>ECC SBE/DBE \u00b7 Throttle reasons \u00b7 NVLink BW \u00b7 XID errors \u00b7 PCIe health</div><div style='margin-top:8px;font-size:10px;color:#f85149'>\u2192 Click to open</div></div></a><a href='http://10.127.28.83:3000/