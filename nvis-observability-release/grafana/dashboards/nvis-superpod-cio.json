    {
      "gridPos": {
        "h": 7,
        "w": 24,
        "x": 0,
        "y": 39
      },
      "id": 35,
      "options": {
        "content": "<div style=\"padding:16px;background:#060d14;border-radius:8px;border:1px solid #1e3a5a;font-family:monospace;font-size:11px\">\n<div style=\"display:grid;grid-template-columns:1fr 1fr 1fr 1fr;gap:12px\">\n\n<div style=\"background:#0d1828;border:1px solid #76b90030;border-radius:6px;padding:14px\">\n  <div style=\"color:#76b900;font-weight:700;font-size:12px;margin-bottom:10px\">\ud83c\udfd7\ufe0f INSTALLED CAPACITY</div>\n  <div style=\"display:flex;justify-content:space-between;padding:3px 0;border-bottom:1px solid #1e3a2a\"><span style=\"color:#8b949e\">GPU Nodes</span><span style=\"color:#7ee787;font-weight:700\">2 \u00d7 DGX A100</span></div>\n  <div style=\"display:flex;justify-content:space-between;padding:3px 0;border-bottom:1px solid #1e3a2a\"><span style=\"color:#8b949e\">GPUs Total</span><span style=\"color:#7ee787;font-weight:700\">2 \u00d7 A100-PCIe-40GB</span></div>\n  <div style=\"display:flex;justify-content:space-between;padding:3px 0;border-bottom:1px solid #1e3a2a\"><span style=\"color:#8b949e\">Total VRAM</span><span style=\"color:#7ee787;font-weight:700\">80 GB</span></div>\n  <div style=\"display:flex;justify-content:space-between;padding:3px 0;border-bottom:1px solid #1e3a2a\"><span style=\"color:#8b949e\">CPU Cores</span><span style=\"color:#7ee787;font-weight:700\">via BCM</span></div>\n  <div style=\"display:flex;justify-content:space-between;padding:3px 0;border-bottom:1px solid #1e3a2a\"><span style=\"color:#8b949e\">Network</span><span style=\"color:#7ee787;font-weight:700\">Spectrum-X RoCE</span></div>\n  <div style=\"display:flex;justify-content:space-between;padding:3px 0\"><span style=\"color:#8b949e\">Cooling</span><span style=\"color:#7ee787;font-weight:700\">Liquid (BCM-10)</span></div>\n</div>\n\n<div style=\"background:#0d1828;border:1px solid #79c0ff30;border-radius:6px;padding:14px\">\n  <div style=\"color:#79c0ff;font-weight:700;font-size:12px;margin-bottom:10px\">\ud83d\udcca SLA CONTRACT</div>\n  <div style=\"display:flex;justify-content:space-between;padding:3px 0;border-bottom:1px solid #1e2a3a\"><span style=\"color:#8b949e\">Target Uptime</span><span style=\"color:#79c0ff;font-weight:700\">99.9%</span></div>\n  <div style=\"display:flex;justify-content:space-between;padding:3px 0;border-bottom:1px solid #1e2a3a\"><span style=\"color:#8b949e\">Downtime Budget</span><span style=\"color:#79c0ff;font-weight:700\">8.76 hrs/year</span></div>\n  <div style=\"display:flex;justify-content:space-between;padding:3px 0;border-bottom:1px solid #1e2a3a\"><span style=\"color:#8b949e\">Per Month</span><span style=\"color:#79c0ff;font-weight:700\">43.8 min</span></div>\n  <div style=\"display:flex;justify-content:space-between;padding:3px 0;border-bottom:1px solid #1e2a3a\"><span style=\"color:#8b949e\">Per Week</span><span style=\"color:#79c0ff;font-weight:700\">10.1 min</span></div>\n  <div style=\"display:flex;justify-content:space-between;padding:3px 0;border-bottom:1px solid #1e2a3a\"><span style=\"color:#8b949e\">RTO (Recovery)</span><span style=\"color:#79c0ff;font-weight:700\">< 30 min</span></div>\n  <div style=\"display:flex;justify-content:space-between;padding:3px 0\"><span style=\"color:#8b949e\">RPO</span><span style=\"color:#79c0ff;font-weight:700\">< 1 hour</span></div>\n</div>\n\n<div style=\"background:#0d1828;border:1px solid #f0c04030;border-radius:6px;padding:14px\">\n  <div style=\"color:#f0c040;font-weight:700;font-size:12px;margin-bottom:10px\">\u26a0\ufe0f ITEMS NEEDING ATTENTION</div>\n  <div style=\"padding:4px 6px;background:#1a1500;border:1px solid #d2992240;border-radius:4px;margin-bottom:4px\">\n    <div style=\"color:#f0c040;font-size:10px;font-weight:700\">BCM TLS Certificate</div>\n    <div style=\"color:#8b949e;font-size:9px\">Expires in ~28 days \u00b7 Redmine #4931377</div>\n  </div>\n  <div style=\"padding:4px 6px;background:#0d1828;border:1px solid #2ea04330;border-radius:4px;margin-bottom:4px\">\n    <div style=\"color:#7ee787;font-size:10px;font-weight:700\">\u2705 Liquid Cooling</div>\n    <div style=\"color:#8b949e;font-size:9px\">No leaks \u00b7 All sensors nominal</div>\n  </div>\n  <div style=\"padding:4px 6px;background:#0d1828;border:1px solid #2ea04330;border-radius:4px;margin-bottom:4px\">\n    <div style=\"color:#7ee787;font-size:10px;font-weight:700\">\u2705 All Nodes Online</div>\n    <div style=\"color:#8b949e;font-size:9px\">0 nodes in RMA \u00b7 2/2 operational</div>\n  </div>\n  <div style=\"padding:4px 6px;background:#0d1828;border:1px solid #2ea04330;border-radius:4px\">\n    <div style=\"color:#7ee787;font-size:10px;font-weight:700\">\u2705 Fabric Healthy</div>\n    <div style=\"color:#8b949e;font-size:9px\">Spectrum-X \u00b7 No PFC/ECN events</div>\n  </div>\n</div>\n\n<div style=\"background:#0d1828;border:1px solid #b57eff30;border-radius:6px;padding:14px\">\n  <div style=\"color:#b57eff;font-weight:700;font-size:12px;margin-bottom:10px\">\ud83e\udd16 COMPUTE CAPACITY</div>\n  <div style=\"display:flex;justify-content:space-between;padding:3px 0;border-bottom:1px solid #2a1e3a\"><span style=\"color:#8b949e\">Peak FP16</span><span style=\"color:#b57eff;font-weight:700\">~624 TFLOPS</span></div>\n  <div style=\"display:flex;justify-content:space-between;padding:3px 0;border-bottom:1px solid #2a1e3a\"><span style=\"color:#8b949e\">Peak BF16</span><span style=\"color:#b57eff;font-weight:700\">~624 TFLOPS</span></div>\n  <div style=\"display:flex;justify-content:space-between;padding:3px 0;border-bottom:1px solid #2a1e3a\"><span style=\"color:#8b949e\">Max Power</span><span style=\"color:#b57eff;font-weight:700\">500W TDP</span></div>\n  <div style=\"display:flex;justify-content:space-between;padding:3px 0;border-bottom:1px solid #2a1e3a\"><span style=\"color:#8b949e\">NVLink BW</span><span style=\"color:#b57eff;font-weight:700\">N/A (PCIe)</span></div>\n  <div style=\"display:flex;justify-content:space-between;padding:3px 0;border-bottom:1px solid #2a1e3a\"><span style=\"color:#8b949e\">NIM Ready</span><span style=\"color:#f0c040;font-weight:700\">Config needed</span></div>\n  <div style=\"display:flex;justify-content:space-between;padding:3px 0\"><span style=\"color:#8b949e\">Token Budget</span><span style=\"color:#f0c040;font-weight:700\">Not set</span></div>\n</div>\n\n</div>\n</div>",
