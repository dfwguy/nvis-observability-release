      "type": "timeseries",
      "title": "CPU Utilization \u2014 live (cgroup)",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 7,
        "w": 12,
        "x": 0,
        "y": 23
      },
      "options": {
        "tooltip": {
          "mode": "multi"
        },
        "legend": {
          "calcs": [],
          "displayMode": "list",
          "placement": "bottom"
        }
      },
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "palette-classic"
          },
          "unit": "percentunit",
          "custom": {
            "lineWidth": 1
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "irate(cgroup_cpu_user_seconds_total{jobid=~\"$JobID\",cluster=~\"$cluster\"}[$interval]) / cgroup_cpus{jobid=~\"$JobID\",cluster=~\"$cluster\"}",
          "legendFormat": "User {{instance}}",
          "refId": "A"
        },
        {
          "datasource": {
            "type": "prometheus",
