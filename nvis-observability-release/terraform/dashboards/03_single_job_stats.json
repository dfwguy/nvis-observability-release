    {
      "id": 204,
      "type": "stat",
      "title": "CPU Efficiency % (CPU-time / elapsed\u00d7CPUs)",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 4,
        "w": 24,
        "x": 0,
        "y": 18
      },
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "justifyMode": "center",
        "orientation": "horizontal",
        "textMode": "value_and_name",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": true
        }
      },
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "unit": "percent",
          "min": 0,
          "max": 100,
          "mappings": [],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "yellow",
                "value": 50
              },
              {
                "color": "green",
                "value": 80
              }
            ]
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "clamp_max(\n  slurm_job_cpu_seconds{cluster=~\"$cluster\",jobid=~\"$JobID\"}\n  / on(cluster,jobid) clamp_min(slurm_job_elapsed_seconds{cluster=~\"$cluster\",jobid=~\"$JobID\"}, 1)\n  / on(cluster,jobid) clamp_min(slurm_job_ncpus{cluster=~\"$cluster\",jobid=~\"$JobID\"}, 1)\n* 100, 100)",
          "legendFormat": "{{jobid}}",
          "refId": "A",
          "instant": true
        }
      ]
    },
