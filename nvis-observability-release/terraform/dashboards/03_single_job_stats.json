{
  "id": 18,
  "uid": "single-job-stats-cod1",
  "title": "Single Job Stats",
  "description": "Per-job metadata, CPU, memory, and GPU metrics. Select a job from the dropdown or the table below.",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "30s",
  "graphTooltip": 1,
  "fiscalYearStartMonth": 0,
  "editable": true,
  "links": [],
  "tags": [
    "slurm",
    "job",
    "gpu",
    "cpu"
  ],
  "annotations": {
    "list": [
      {
        "builtIn": 1,
        "datasource": "-- Grafana --",
        "enable": true,
        "hide": true,
        "iconColor": "rgba(0,211,255,1)",
        "name": "Annotations & Alerts",
        "type": "dashboard"
      }
    ]
  },
  "templating": {
    "list": [
      {
        "name": "loki_datasource",
        "type": "datasource",
        "label": "Loki",
        "pluginId": "loki",
        "query": "loki",
        "hide": 0,
        "current": {
          "text": "nvis-loki",
          "value": "nvis-loki"
        }
      },
      {
        "name": "datasource",
        "type": "datasource",
        "label": "Prometheus/VM",
        "pluginId": "prometheus",
        "query": "prometheus",
        "hide": 0,
        "current": {}
      },
      {
        "name": "cluster",
        "type": "query",
        "label": "Cluster",
        "datasource": {
          "type": "prometheus",
          "uid": "${datasource}"
        },
        "query": {
          "query": "label_values(up{job=\"node-exporter\"}, cluster)",
          "refId": "StandardVariableQuery"
        },
        "refresh": 2,
        "sort": 1,
        "includeAll": false,
        "multi": false,
        "current": {}
      },
      {
        "name": "user",
        "type": "query",
        "label": "User",
        "datasource": {
          "type": "prometheus",
          "uid": "${datasource}"
        },
        "query": {
          "query": "label_values(slurm_job_info{cluster=~\"$cluster\"}, user)",
          "refId": "StandardVariableQuery"
        },
        "refresh": 2,
        "sort": 1,
        "includeAll": true,
        "multi": false,
        "allValue": ".*",
        "current": {}
      },
      {
        "name": "JobID",
        "type": "query",
        "label": "Job ID",
        "datasource": {
          "type": "prometheus",
          "uid": "${datasource}"
        },
        "query": {
          "query": "label_values(slurm_job_info{cluster=~\"$cluster\",user=~\"$user\"}, jobid)",
          "refId": "StandardVariableQuery"
        },
        "refresh": 2,
        "sort": 2,
        "includeAll": true,
        "multi": true,
        "allValue": ".*",
        "current": {}
      },
      {
        "name": "node",
        "type": "query",
        "label": "Node",
        "datasource": {
          "type": "prometheus",
          "uid": "${datasource}"
        },
        "query": {
          "query": "label_values(node_uname_info{cluster=~\"$cluster\"}, instance)",
          "refId": "StandardVariableQuery"
        },
        "refresh": 2,
        "sort": 1,
        "includeAll": true,
        "multi": true,
        "allValue": ".*",
        "current": {},
        "regex": "^(?!localhost).*"
      },
      {
        "name": "interval",
        "type": "interval",
        "label": "Interval",
        "query": "1m,2m,5m,10m",
        "current": {
          "text": "5m",
          "value": "5m"
        },
        "options": [
          {
            "text": "1m",
            "value": "1m"
          },
          {
            "text": "2m",
            "value": "2m"
          },
          {
            "text": "5m",
            "value": "5m"
          },
          {
            "text": "10m",
            "value": "10m"
          }
        ]
      }
    ]
  },
  "panels": [
    {
      "id": 49,
      "type": "row",
      "title": "Recent Jobs",
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 0
      }
    },
    {
      "id": 50,
      "type": "table",
      "title": "\ud83d\udccb Recent Jobs (last 72h) \u2014 select a Job ID above",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 8,
        "w": 24,
        "x": 0,
        "y": 1
      },
      "options": {
        "sortBy": [
          {
            "desc": true,
            "displayName": "jobid"
          }
        ],
        "footer": {
          "show": false,
          "reducer": [
            "sum"
          ],
          "enablePagination": true
        },
        "frameIndex": 0,
        "showHeader": true
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "auto",
            "displayMode": "auto"
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "Value"
            },
            "properties": [
              {
                "id": "custom.hidden",
                "value": true
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Time"
            },
            "properties": [
              {
                "id": "custom.hidden",
                "value": true
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "__name__"
            },
            "properties": [
              {
                "id": "custom.hidden",
                "value": true
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "state"
            },
            "properties": [
              {
                "id": "custom.displayMode",
                "value": "color-background"
              },
              {
                "id": "mappings",
                "value": [
                  {
                    "type": "value",
                    "options": {
                      "COMPLETED": {
                        "color": "green",
                        "text": "COMPLETED"
                      },
                      "RUNNING": {
                        "color": "blue",
                        "text": "RUNNING"
                      },
                      "FAILED": {
                        "color": "red",
                        "text": "FAILED"
                      },
                      "CANCELLED": {
                        "color": "orange",
                        "text": "CANCELLED"
                      },
                      "TIMEOUT": {
                        "color": "yellow",
                        "text": "TIMEOUT"
                      },
                      "PENDING": {
                        "color": "purple",
                        "text": "PENDING"
                      }
                    }
                  }
                ]
              }
            ]
          }
        ]
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "slurm_job_info{cluster=~\"$cluster\",user=~\"$user\"}",
          "legendFormat": "{{jobid}}",
          "refId": "A",
          "instant": true,
          "format": "table"
        }
      ],
      "transformations": [
        {
          "id": "labelsToFields",
          "options": {
            "mode": "columns",
            "valueLabel": ""
          }
        },
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Value": true,
              "Time": true,
              "__name__": true
            },
            "indexByName": {
              "jobid": 0,
              "user": 1,
              "state": 2,
              "partition": 3,
              "nnodes": 4,
              "ncpus": 5,
              "cluster": 6
            }
          }
        }
      ]
    },
