{
  "id": 30,
  "panels": [
    {
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "title": "\ud83d\udda5\ufe0f Hardware Inventory (auto-discovered from Prometheus)",
      "type": "row",
      "id": 1
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "fieldConfig": {
        "defaults": {
          "color": {
            "fixedColor": "blue",
            "mode": "fixed"
          },
          "noValue": "N/A"
        }
      },
      "gridPos": {
        "h": 3,
        "w": 4,
        "x": 0,
        "y": 1
      },
      "options": {
        "colorMode": "value",
        "graphMode": "none",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "textMode": "name"
      },
      "targets": [
        {
          "expr": "node_os_info{cluster=~\"$cluster\",instance=~\"$node\"}",
          "instant": true,
          "legendFormat": "{{pretty_name}}",
          "refId": "A"
        }
      ],
      "title": "OS",
      "type": "stat",
      "id": 2
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "fieldConfig": {
        "defaults": {
          "color": {
            "fixedColor": "blue",
            "mode": "fixed"
          },
          "noValue": "N/A"
        }
      },
      "gridPos": {
        "h": 3,
        "w": 4,
        "x": 4,
        "y": 1
      },
      "options": {
        "colorMode": "value",
        "graphMode": "none",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "textMode": "name"
      },
      "targets": [
        {
          "expr": "node_uname_info{cluster=~\"$cluster\",instance=~\"$node\"}",
