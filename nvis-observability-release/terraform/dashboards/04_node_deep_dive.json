      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          }
        }
      },
      "gridPos": {
        "h": 3,
        "w": 2,
        "x": 13,
        "y": 1
      },
      "options": {
        "colorMode": "value",
        "graphMode": "none",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        }
      },
      "targets": [
        {
          "expr": "count(DCGM_FI_DEV_GPU_TEMP{cluster=~\"$cluster\",instance=~\"$node\"})",
          "legendFormat": "GPUs",
          "refId": "A"
        }
