      "targets": [
        {
          "expr": "DCGM_FI_DEV_FB_USED{cluster=~\"$cluster\",instance=~\"$node\"}+DCGM_FI_DEV_FB_FREE{cluster=~\"$cluster\",instance=~\"$node\"}",
