      "options": {
        "colorMode": "value",
        "graphMode": "none",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "textMode": "name"
      },
      "targets": [
        {
          "expr": "topk(1, DCGM_FI_DEV_POWER_USAGE{cluster=~\"$cluster\",instance=~\"$node\"})",
