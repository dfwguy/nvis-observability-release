        {
          "expr": "node_memory_Cached_bytes{cluster=~\"$cluster\",instance=~\"$node\"}",
          "legendFormat": "Cached",
          "refId": "B"
        },
        {
          "expr": "node_memory_MemFree_bytes{cluster=~\"$cluster\",instance=~\"$node\"}",
          "legendFormat": "Free",
          "refId": "C"
        }
