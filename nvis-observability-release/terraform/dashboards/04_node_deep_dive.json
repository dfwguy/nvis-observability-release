          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "expr": "node_memory_MemTotal_bytes{cluster=~\"$cluster\",instance=~\"$node\"}-node_memory_MemFree_bytes{cluster=~\"$cluster\",instance=~\"$node\"}-node_memory_Cached_bytes{cluster=~\"$cluster\",instance=~\"$node\"}-node_memory_Buffers_bytes{cluster=~\"$cluster\",instance=~\"$node\"}",
          "legendFormat": "Used",
          "refId": "A"
