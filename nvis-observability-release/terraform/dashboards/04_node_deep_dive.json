        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "expr": "node_netstat_Tcp_CurrEstab{cluster=~\"$cluster\",instance=~\"$node\"}",
          "legendFormat": "TCP Established",
