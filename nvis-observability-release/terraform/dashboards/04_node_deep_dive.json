    {
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 4
      },
      "title": "\ud83d\udcbb CPU & Memory",
      "type": "row",
      "id": 9
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "line",
            "fillOpacity": 20,
            "gradientMode": "opacity",
            "lineWidth": 2
          },
          "max": 100,
          "min": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "transparent",
                "value": null
              },
              {
                "color": "yellow",
                "value": 70
              },
              {
                "color": "red",
                "value": 90
              }
            ]
          },
          "unit": "percent"
        }
      },
      "gridPos": {
        "h": 6,
        "w": 8,
        "x": 0,
        "y": 5
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "expr": "100 - (avg(rate(node_cpu_seconds_total{cluster=~\"$cluster\",instance=~\"$node\",mode=\"idle\"}[2m]))*100)",
          "legendFormat": "CPU %",
          "refId": "A"
        },
        {
          "expr": "avg(rate(node_cpu_seconds_total{cluster=~\"$cluster\",instance=~\"$node\",mode=\"iowait\"}[2m]))*100",
          "legendFormat": "IOWait %",
          "refId": "B"
        }
      ],
      "title": "CPU Utilization %",
      "type": "timeseries",
      "id": 10
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
