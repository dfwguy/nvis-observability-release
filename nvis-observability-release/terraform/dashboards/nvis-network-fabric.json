      "id": 18,
      "options": {
        "code": {
          "language": "plaintext",
          "showLineNumbers": false,
          "showMiniMap": false
        },
        "content": "<div style='display:grid;grid-template-columns:1fr 1fr 1fr;gap:16px;padding:12px'><div style='background:#0d1f3a;border:1px solid #388bfd;border-radius:6px;padding:12px'><div style='color:#388bfd;font-weight:bold;margin-bottom:8px'>InfiniBand (UFM Enterprise)</div><div style='color:#aaa;font-size:11px;line-height:1.8'>1. Install UFM Enterprise on management node<br>2. Enable UFM Telemetry plugin (REST API :9200)<br>3. Add Prometheus scrape: <code>http://ufm-host:9200/metrics</code><br>4. Metrics: ib_port_*, ufm_link_*, ufm_switch_*<br><br><b style='color:#7ee787'>Works with:</b> HDR, NDR InfiniBand fabrics</div></div><div style='background:#1a0d2e;border:1px solid #bc8cff;border-radius:6px;padding:12px'><div style='color:#bc8cff;font-weight:bold;margin-bottom:8px'>Spectrum-X (UFM Cyber-AI)</div><div style='color:#aaa;font-size:11px;line-height:1.8'>1. Install UFM Cyber-AI Platform<br>2. Enable Prometheus exporter on :9200<br>3. Add SNMP exporter for switch ports<br>4. Metrics: roce_*, spectrum_*, pfc_*, ecn_*<br><br><b style='color:#7ee787'>Eli Lilly uses:</b> Spectrum-X 2.0 + RoCE v2</div></div><div style='background:#0d2014;border:1px solid #2ea043;border-radius:6px;padding:12px'><div style='color:#7ee787;font-weight:bold;margin-bottom:8px'>NCCL Proxy Metrics (today)</div><div style='color:#aaa;font-size:11px;line-height:1.8'>Without UFM, use node_exporter:<br>\u2022 TCP connections = NCCL ring size<br>\u2022 Socket count = active collectives<br>\u2022 Retransmits = fabric congestion<br>\u2022 NIC throughput = actual bandwidth<br><br><b style='color:#f0c040'>Add UFM to get:</b> per-port BW, utilization %, switch health</div></div></div>",
        "mode": "html"
      },
      "pluginVersion": "11.1.4",
      "title": "UFM Telemetry Integration \u2014 How to Connect",
      "type": "text"
    },
    {
      "gridPos": {
        "h": 18,
        "w": 24,
        "x": 0,
        "y": 35
      },
      "id": 19,
      "options": {
        "code": {
          "language": "plaintext",
          "showLineNumbers": false,
          "showMiniMap": false
        },
        "content": "<style>\n.tc{position:relative;width:100%;height:380px;overflow:hidden;background:#000;border-radius:6px;border:1px solid #1a2a1a}\n.nd{position:absolute;border:1px solid #2ea04380;border-radius:4px;background:#000;color:#7ee787;font-size:9px;padding:4px 8px;min-width:75px;cursor:default;text-align:center;z-index:10;font-family:monospace;white-space:nowrap}\n.nd .nn{font-weight:700;font-size:10px}\n.nd .ns{font-size:7px;opacity:.5;margin-top:1px}\n.sv{position:absolute;top:0;left:0;width:100%;height:100%;pointer-events:none}\n.leg{position:absolute;bottom:4px;right:8px;display:flex;gap:12px;font-size:8px;color:#4a7a4a;font-family:monospace}\n.ld{display:inline-block;width:20px;height:1px;margin-right:3px;vertical-align:middle}\n.info{position:absolute;bottom:4px;left:8px;font-size:8px;color:#2ea04350;font-family:monospace}\n</style>\n<div class=\"tc\" id=\"tc\">\n<svg class=\"sv\" id=\"sv\"></svg>\n<!-- OOB: top-left like Air reference -->\n<div class=\"nd\" id=\"nOOB\" style=\"left:2%;top:18px;border-color:#2ea043\"><div class=\"nn\">oob-mgmt-switch</div><div class=\"ns\">Cumulus VX \u00b7 OOB</div></div>\n<!-- Spines: center, spread -->\n<div class=\"nd\" id=\"nS1\" style=\"left:37%;top:115px;border-color:#79c0ff\"><div class=\"nn\">spine-01</div><div class=\"ns\">Spectrum-X</div></div>\n<div class=\"nd\" id=\"nS2\" style=\"left:56%;top:115px;border-color:#79c0ff\"><div class=\"nn\">spine-02</div><div class=\"ns\">Spectrum-X</div></div>\n<!-- Leaves: wide spread -->\n<div class=\"nd\" id=\"nL1\" style=\"left:8%;top:225px;border-color:#2ea043\"><div class=\"nn\">leaf-01</div><div class=\"ns\">Cumulus VX</div></div>\n<div class=\"nd\" id=\"nL2\" style=\"left:33%;top:225px;border-color:#2ea043\"><div class=\"nn\">leaf-02</div><div class=\"ns\">Cumulus VX</div></div>\n<div class=\"nd\" id=\"nL3\" style=\"left:58%;top:225px;border-color:#2ea043\"><div class=\"nn\">leaf-03</div><div class=\"ns\">Cumulus VX</div></div>\n<div class=\"nd\" id=\"nL4\" style=\"left:83%;top:225px;border-color:#2ea043\"><div class=\"nn\">leaf-04</div><div class=\"ns\">Cumulus VX</div></div>\n<!-- Compute: bottom row matching Air -->\n<div class=\"nd\" id=\"nBCM\" style=\"left:2%;top:320px;border-color:#d29922;color:#f0c040\"><div class=\"nn\">bcm-01</div><div class=\"ns\">BCM Head</div></div>\n<div class=\"nd\" id=\"nC1\" style=\"left:18%;top:320px;border-color:#2ea043\"><div class=\"nn\">cpu-01</div><div class=\"ns\">Compute</div></div>\n<div class=\"nd\" id=\"nC2\" style=\"left:35%;top:320px;border-color:#2ea043\"><div class=\"nn\">cpu-02</div><div class=\"ns\">Compute</div></div>\n<div class=\"nd\" id=\"nC3\" style=\"left:52%;top:320px;border-color:#2ea043\"><div class=\"nn\">cpu-03</div><div class=\"ns\">Compute</div></div>\n<div class=\"nd\" id=\"nC4\" style=\"left:69%;top:320px;border-color:#2ea043\"><div class=\"nn\">cpu-04</div><div class=\"ns\">Compute</div></div>\n<div class=\"nd\" id=\"nC5\" style=\"left:86%;top:320px;border-color:#2ea043\"><div class=\"nn\">cpu-05</div><div class=\"ns\">Compute</div></div>\n<div class=\"leg\">\n  <span><span class=\"ld\" style=\"background:#ffffff20\"></span>Mgmt</span>\n  <span><span class=\"ld\" style=\"background:#79c0ff\"></span>Spine fabric</span>\n  <span><span class=\"ld\" style=\"background:#f0c04060\"></span>Congestion warning</span>\n  <span><span class=\"ld\" style=\"background:#f8514960\"></span>Critical / fault</span>\n</div>\n<div class=\"info\" id=\"ainfo\">Sim: 202603001-BCM-Lab &nbsp; Fabric: 2x spine / 4x leaf ECMP &nbsp; PFC: -- &nbsp; ECN: -- &nbsp; Updated: --</div>\n</div>\n<script>\nvar E=[\n  {a:'nOOB',b:'nS1',c:'#ffffff15',w:1,d:'4,3'},\n  {a:'nOOB',b:'nS2',c:'#ffffff15',w:1,d:'4,3'},\n  {a:'nOOB',b:'nL1',c:'#ffffff10',w:1,d:'4,3'},\n  {a:'nOOB',b:'nL2',c:'#ffffff10',w:1,d:'4,3'},\n  {a:'nOOB',b:'nL3',c:'#ffffff10',w:1,d:'4,3'},\n  {a:'nOOB',b:'nL4',c:'#ffffff10',w:1,d:'4,3'},\n  {a:'nOOB',b:'nBCM',c:'#ffffff08',w:1,d:'4,3'},\n  {a:'nOOB',b:'nC1',c:'#ffffff08',w:1,d:'4,3'},\n  {a:'nOOB',b:'nC2',c:'#ffffff08',w:1,d:'4,3'},\n  {a:'nOOB',b:'nC3',c:'#ffffff08',w:1,d:'4,3'},\n  {a:'nOOB',b:'nC4',c:'#ffffff08',w:1,d:'4,3'},\n  {a:'nOOB',b:'nC5',c:'#ffffff08',w:1,d:'4,3'},\n  {a:'nS1',b:'nL1',c:'#79c0ff',w:1.5},\n  {a:'nS1',b:'nL2',c:'#79c0ff',w:1.5},\n  {a:'nS1',b:'nL3',c:'#79c0ff',w:1.5},\n  {a:'nS1',b:'nL4',c:'#79c0ff',w:1.5},\n  {a:'nS2',b:'nL1',c:'#79c0ff',w:1.5},\n  {a:'nS2',b:'nL2',c:'#79c0ff',w:1.5},\n  {a:'nS2',b:'nL3',c:'#79c0ff',w:1.5},\n  {a:'nS2',b:'nL4',c:'#79c0ff',w:1.5},\n  {a:'nL1',b:'nBCM',c:'#2ea04360',w:1.2},\n  {a:'nL1',b:'nC1',c:'#2ea04360',w:1.2},\n  {a:'nL2',b:'nC1',c:'#2ea04360',w:1.2},\n  {a:'nL2',b:'nC2',c:'#2ea04360',w:1.2},\n  {a:'nL3',b:'nC3',c:'#2ea04360',w:1.2},\n  {a:'nL3',b:'nC4',c:'#2ea04360',w:1.2},\n  {a:'nL4',b:'nC4',c:'#2ea04360',w:1.2},\n  {a:'nL4',b:'nC5',c:'#2ea04360',w:1.2}\n];\nfunction ct(id){var c=document.getElementById('tc').getBoundingClientRect(),e=document.getElementById(id).getBoundingClientRect();return{x:e.left-c.left+e.width/2,y:e.top-c.top+e.height/2};}\nfunction dre(){\n  var sv=document.getElementById('sv');if(!sv)return;\n  var s='';\n  E.forEach(function(e){\n    try{var a=ct(e.a),b=ct(e.b),mx=(a.x+b.x)/2,my=(a.y+b.y)/2;\n    s+='<path d=\"M'+a.x+' '+a.y+' Q'+mx+' '+my+' '+b.x+' '+b.y+'\" stroke=\"'+e.c+'\" stroke-width=\"'+(e.w||1)+'\" fill=\"none\"'+(e.d?' stroke-dasharray=\"'+e.d+'\"':'')+'/>'; }catch(x){}\n  });\n  sv.innerHTML=s;\n}\ndre();setInterval(dre,5000);window.addEventListener('resize',dre);\n</script>",
